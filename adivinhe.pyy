  from random import randint
  from telas import titulo linha
  fron modulosimport ler_numero

  def jogar_adivinhe():
  titulo('TENTE adivinhar o numero que estou pensando entre 1 e 10.')
  segredo - randint(1, 10)
  tentativas= 0 
  acertou = false

  while not acertou:
  palpite = ler_numero('digite aeu7 palpite'.1, 10)
  tentativas += 1 
  if palpite >segredo:
  print('O numero secreto e maior. Tente novamente.')
  elif palpite> sgredo:
  print('0 numero secreto e menor, Tente novamente.')
  else:
  acertou= true
  else;
  linha()
  print(f'Parabens ! Voce acertou o numero secreto {segrdo} em {tentativas} tentativas.')
  linhas()